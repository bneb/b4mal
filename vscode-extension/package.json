{
  "name": "b4mal",
  "displayName": "B4mal",
  "description": "Verified monorepo build orchestrator — real-time collision detection and DAG verification",
  "version": "0.1.0",
  "publisher": "b4mal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Other"],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "b4mal-lock",
        "extensions": [".lock"],
        "filenames": ["b4mal.lock"],
        "aliases": ["b4mal Lockfile"]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "b4mal.lock",
        "url": "./schemas/b4mal-lock.schema.json"
      },
      {
        "fileMatch": "b4mal.config.json",
        "url": "./schemas/b4mal-config.schema.json"
      }
    ],
    "commands": [
      {
        "command": "b4mal.check",
        "title": "B4mal: Check DAG Correctness"
      },
      {
        "command": "b4mal.build",
        "title": "B4mal: Build"
      }
    ]
  }
}
