{
  "name": "b4mal",
  "version": "0.1.1",
  "description": "Verified monorepo build orchestrator — formal resource-conflict detection, deterministic caching, and DAG execution",
  "type": "module",
  "license": "MIT",
  "author": "Kevin <oconn.kv@gmail.com>",
  "homepage": "https://github.com/bneb/b4mal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bneb/b4mal.git"
  },
  "bugs": {
    "url": "https://github.com/bneb/b4mal/issues"
  },
  "keywords": [
    "build",
    "monorepo",
    "orchestrator",
    "dag",
    "cache",
    "deterministic",
    "task-runner",
    "bun"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "b4mal": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --outdir dist --target bun",
    "test": "bun test",
    "bench": "bun run benchmarks/cold-start.ts && bun run benchmarks/parallel-overhead.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "js-yaml": "^4.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22.6",
    "yaml": "^2.8.2",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  }
}
